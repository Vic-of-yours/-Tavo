{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aster.dashboard.orbit-entry/v1.1",
  "title": "Aster dashboard orbit entry v1.1",
  "x-aster-api": {
    "register": "registerOrbit",
    "unregister": "unregisterOrbit",
    "registerAlias": "registerOrbitEntry",
    "unregisterAlias": "unregisterOrbitEntry",
    "outerRingFacade": "registerRoute"
  },
  "x-aster-state": {
    "sourceOfTruth": "activeId",
    "index": "derived from the current sorted ring entries",
    "restoreOrder": ["activeId", "nearest-valid-index", "first-entry"]
  },
  "type": "object",
  "required": ["id", "ring", "label", "iconAssetId", "order", "action"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ring": { "enum": ["inner", "outer"] },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "iconAssetId": {
      "type": "string",
      "minLength": 1,
      "description": "Asset-registry identity; renderers resolve it and may fall back to a generic icon without changing entry identity."
    },
    "order": { "type": "number" },
    "accent": { "enum": ["cyan", "violet", "mint", "warning", "neutral"] },
    "badge": { "type": ["string", "number", "null"] },
    "disabled": { "type": "boolean", "default": false },
    "action": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": { "enum": ["panel", "command", "custom"] },
        "target": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
