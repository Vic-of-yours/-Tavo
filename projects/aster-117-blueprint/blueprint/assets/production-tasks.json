      "geometry": { "viewBox": "0 0 24 24", "safeInset": 2, "strokeWidth": 1.5, "stroke": "currentColor", "fill": "none", "linecap": "round", "linejoin": "round" },
      "iconIds": [
        "back", "close", "search", "filter", "sort", "add", "more",
        "dashboard", "map", "location", "bag", "quest", "following", "home", "pet", "equipment", "craft",
        "message", "forum", "live", "notification",
        "data", "resource", "theme", "settings", "lock", "unlock", "edit", "delete",
        "character", "lorebook", "regex", "preset", "image", "audio", "video", "font", "text", "binary", "archive",
        "info", "success", "warning", "error",
        "codex", "sticker", "gallery", "voice", "music", "book", "marker", "developer",
        "modules", "form", "diagnostics", "parameters", "catalog", "drawer", "calendar", "journal"
